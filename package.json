{
  "name": "calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "// --- BUILDING ---": "",
    "build": "pnpm run build:prebuild && tsc && vite build && pnpm run build:postbuild",
    "build:prebuild": "pnpm run fix && pnpm run check && pnpm run test",
    "build:postbuild": "pnpm run fix",
    "dev": "vite",
    "preview": "vite preview",
    "// --- CHECKING & FORMATTING & LINTING ---": "",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint:check",
    "fix": "pnpm run format:fix && pnpm run lint:fix",
    "format": "pnpm run format:fix",
    "format:check": "prettier . --check --ignore-unknown --cache",
    "format:fix": "prettier . --write --ignore-unknown --cache",
    "lint": "pnpm run lint:fix",
    "lint:check": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "// --- TESTING ---": "",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:e2e": "pnpm exec playwright test --project chromium",
    "test:e2e:ui": "pnpm exec playwright test --ui --project chromium",
    "test:watch": "vitest",
    "// --- CI ---": "",
    "ci:check": "pnpm run check",
    "ci:test:unit": "pnpm run coverage",
    "ci:test:e2e": "pnpm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
