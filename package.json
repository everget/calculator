{
  "name": "calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "// --- BUILDING ---": "",
    "build": "pnpm run build:swap:dev && tsc && vite build && pnpm run build:swap:prod",
    "build:swap": "node ./scripts/swap-urls.mjs",
    "build:swap:dev": "pnpm run build:swap -- --dev",
    "build:swap:prod": "pnpm run build:swap -- --prod",
    "dev": "pnpm run build:swap:dev && vite",
    "preview": "pnpm run build && vite preview",
    "// --- CHECKING & FORMATTING & LINTING ---": "",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint:check",
    "fix": "pnpm run format:fix && pnpm run lint:fix",
    "format": "pnpm run format:fix",
    "format:check": "prettier . --check --ignore-unknown --cache",
    "format:fix": "prettier . --write --ignore-unknown --cache",
    "lint": "pnpm run lint:fix",
    "lint:check": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "// --- TESTING ---": "",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:e2e": "pnpm exec playwright test --project chromium",
    "test:e2e:ui": "pnpm exec playwright test --ui --project chromium",
    "test:watch": "vitest",
    "// --- CI ---": "",
    "ci:lint": "pnpm run check",
    "ci:test:unit": "pnpm run coverage",
    "ci:test:e2e": "pnpm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@9.11.0+sha512.0a203ffaed5a3f63242cd064c8fb5892366c103e328079318f78062f24ea8c9d50bc6a47aa3567cabefd824d170e78fa2745ed1f16b132e16436146b7688f19b"
}
